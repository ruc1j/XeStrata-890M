# XeStrata-890M in a container: this fork's Fedora 44 rpm, built with tools/package/build.sh fedora44 free and put in
# container/rpm/ (the fork publishes no packages: README), with the free runtime its BUILD.json records (ROCm's HIP,
# rocBLAS, hipBLASLt).  Built on the user's PC (podman compose build).  docs/BUILD.md#podman
# the image tools/package/build.sh builds the Fedora 44 packages in
ARG FEDORA=docker.io/library/fedora@sha256:43b29f65a41eb9c35e1cd5323e3bdf3b655c2357a9f4f1ff2f9c2798e5045d80
FROM ${FEDORA}
ARG XESTRATA_VERSION=latest
ARG XESTRATA_VARIANT=free
ARG XESTRATA_NONFREE=0
# (relabel: SELinux lets the build read the folder)
RUN --mount=type=bind,source=.,target=/ctx,relabel=shared \
    XESTRATA_VERSION="$XESTRATA_VERSION" XESTRATA_VARIANT="$XESTRATA_VARIANT" XESTRATA_NONFREE="$XESTRATA_NONFREE" \
    sh /ctx/install.sh
# the browser is the host's: the server only listens (on the host's loopback, compose.yaml)
ENTRYPOINT ["xestrata"]
CMD ["--no-browser"]
